# ==============================================================================
# AIRA Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to '.env' if you wish to configure live online LLMs.
# Note: AIRA is fully operational OFFLINE using deterministic Graph-RAG. 
# Providing API keys is completely optional.

# --- Optional Online LLM Co-Pilot Keys ---
# Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# OpenAI API Key (e.g. sk-proj-...)
OPENAI_API_KEY=

# --- Server Settings ---
AIRA_HOST=127.0.0.1
AIRA_PORT=8000
